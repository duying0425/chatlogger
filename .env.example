# 飞书应用配置
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OAuth 重定向地址（生产环境）
REDIRECT_URI=https://chatlogger.tmhcorps.cn/auth/callback

# 应用密钥（生成随机字符串）
SECRET_KEY=your-random-secret-key-here

# 数据库路径（默认在项目目录下）
# DB_PATH=/data/chatlogger.db
# 数据库路径（Docker 持久化部署推荐: /app/data/chatlogger.db）
# DB_PATH=/app/data/chatlogger.db

# 本地 Markdown 归档与附件缓存路径（Docker 持久化推荐: /app/cache 或 /app/data/cache）
# LOCAL_CACHE_DIR=/app/cache

# 默认是否开启本地缓存（true / false）
# DEFAULT_LOCAL_CACHE=true

# 单个附件/图片下载与上传大小上限（MB，默认 20MB）
# 超出大小限制的文件将自动跳过，并在多维表格备注列与本地缓存中动态记录原因
MAX_ATTACHMENT_SIZE_MB=20

# 服务器配置
# HOST=0.0.0.0
# PORT=5000
# DEBUG=false
